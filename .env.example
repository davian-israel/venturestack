# ---------- Core (api, worker, marketer) ----------
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
PUBLIC_WEB_URL=https://<web-domain>
PUBLIC_API_URL=https://<api-domain>
JWT_SECRET=<64 random chars>
ENCRYPTION_KEY=<64 random chars, never change after first client>
OWNER_EMAIL=davianr@gmail.com

# ---------- Payments (required for the paywall) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # printed by `npm run stripe:bootstrap`
PAST_DUE_GRACE_DAYS=7

# ---------- Fulfilment ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RESEND_API_KEY=                        # client emails (magic links, digests, reports)
MAIL_FROM=Venturestack <hello@yourdomain.com>
RAILWAY_API_TOKEN=                     # per-client Metabase / Paperless / Invoice Ninja
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
REDDIT_CLIENT_ID=                      # Agent Reach sources (official APIs only)
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
DUB_API_KEY=                           # Offline Attribution
GPU_DUB_ENDPOINT=                      # Voice Studio GPU worker (Modal/RunPod)
GPU_DUB_TOKEN=

# ---------- Marketing (marketer cron, 03:00 Europe/London) ----------
MARKETING_ENABLED=false                # flip to true when the items below are set
MARKETING_MAX_WAVE=1                   # 1 = Agent Reach only; 2 = +4 more; 3 = all 8
MARKETING_DAILY_SEND_CAP=60            # new prospects enrolled per day (≈30 per warmed inbox)
MARKETING_POSTAL_ADDRESS=              # REQUIRED: emails are blocked until set
MARKETING_BOOKING_URL=                 # REQUIRED for step 3
MARKETING_CLIENT_CLAIMS=false          # true only once you have paying clients
MARKETING_SENDER_NAME=Davian
MARKETING_SENDER_TITLE=Founder
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGNS={"agent-reach":"<campaign-id>"}
APOLLO_API_KEY=                        # or TREG_API_KEY + TREG_PEOPLE_CALL
TREG_API_KEY=
TREG_PEOPLE_CALL=
X_BEARER_TOKEN=                        # user-context token for your own company account
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:<id>

# ---------- web ----------
NEXT_PUBLIC_API_URL=https://<api-domain>
API_INTERNAL_URL=http://api.railway.internal:3001

# ---------- Growth dashboard & weekly optimiser ----------
TARGET_DATE=2027-04-30                 # date to reach $26,100/mo (editable in /admin)
MONTHLY_FIXED_COST_USD=0               # Railway + Instantly + Apollo + domains… (editable in /admin)
MARKETING_SEND_CAP_CEILING=150         # optimiser never raises daily new prospects above this
PROSPECT_COST_CENTS=1                  # cost per prospect pulled (Treg/Apollo credits)
ANTHROPIC_INPUT_USD_PER_MTOK=3         # for measured AI cost
ANTHROPIC_OUTPUT_USD_PER_MTOK=15
STRIPE_FEE_PCT=2.9                     # fee estimate per payment
STRIPE_FEE_FIXED_CENTS=30
